# Copy to .env and fill in values before running

# Database
DATABASE_URL=mysql+aiomysql://root:root@localhost:3306/robot_db

# Redis
REDIS_URL=redis://localhost:6379/0

# JWT — use a long random string in production
JWT_SECRET=change-me-in-production
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Robot auth
ROBOT_API_KEY=change-me-robot-key

# First admin account (seeded on first startup if no admin exists)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-admin-password

# Simulation
SIMULATION_MODE=false
SIM_NAV_DELAY_S=5
SIM_NAV_SUCCESS_RATE=0.9
SIM_SLAM_HZ=10
SIM_PATH=random_walk

# App
DEBUG=false
